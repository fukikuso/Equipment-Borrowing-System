<%- include('../partials/app-open', {sidebarType: 'admin'}) %>

<div class="page-header"><h1>User Management</h1><p>Manage student, instructor, staff, and administrator accounts.</p></div>

<div class="card mb-16">
  <form method="GET" action="/admin/users" class="flex gap-10" style="flex-wrap:wrap;">
    <input type="text" name="q" placeholder="Search by name or ID..." value="<%= filters.q %>" style="flex:1;min-width:220px;">
    <select name="role" style="max-width:200px;" onchange="this.form.submit()">
      <option value="all" <%= filters.role === 'all' ? 'selected' : '' %>>All Roles</option>
      <option value="student" <%= filters.role === 'student' ? 'selected' : '' %>>Student</option>
      <option value="instructor" <%= filters.role === 'instructor' ? 'selected' : '' %>>Instructor</option>
      <option value="staff" <%= filters.role === 'staff' ? 'selected' : '' %>>Staff</option>
      <option value="admin" <%= filters.role === 'admin' ? 'selected' : '' %>>Administrator</option>
    </select>
    <button type="submit" class="btn btn-primary"><i data-lucide="search"></i> Search</button>
  </form>
</div>

<div class="card card-flush">
  <div class="table-wrap">
    <table>
      <thead><tr><th>Name</th><th>ID</th><th>Department</th><th>Active Borrowings</th><th>Overdue</th><th>Status</th><th>Actions</th></tr></thead>
      <tbody>
        <% rows.forEach(function(u) { %>
        <tr>
          <td class="font-semibold"><%= u.full_name %> <span class="badge badge-info" style="margin-left:6px"><%= u.role %></span></td>
          <td><%= u.id_number %></td>
          <td class="text-sm"><%= u.department || u.program || '—' %></td>
          <td><%= u.active_borrowings %></td>
          <td><% if (u.overdue_items > 0) { %><span class="badge badge-danger"><%= u.overdue_items %></span><% } else { %>0<% } %></td>
          <td><span class="badge <%= u.account_status === 'active' ? 'badge-success' : 'badge-neutral' %>"><%= u.account_status %></span></td>
          <td>
            <div class="flex gap-6">
              <a href="/admin/users/<%= u.id %>" class="btn btn-ghost btn-sm" title="View"><i data-lucide="eye"></i></a>
              <form action="/admin/users/<%= u.id %>/toggle-status" method="POST" onsubmit="return confirm('<%= u.account_status === 'active' ? 'Deactivate' : 'Activate' %> this account?')">
                <button class="btn btn-ghost btn-sm" style="color:<%= u.account_status === 'active' ? 'var(--danger)' : 'var(--success)' %>" title="Toggle status">
                  <i data-lucide="<%= u.account_status === 'active' ? 'user-x' : 'user-check' %>"></i>
                </button>
              </form>
            </div>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/app-close') %>
