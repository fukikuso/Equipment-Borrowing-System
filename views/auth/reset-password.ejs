<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <div class="login-shell">
    <div class="login-panel">
      <div class="login-card">
        <div class="ic-badge"><i data-lucide="lock-keyhole"></i></div>
        <h2>Choose a New Password</h2>
        <p class="subtitle">Create a new password with at least 8 characters.</p>

        <%- include('../partials/flash') %>

        <form action="/reset-password/<%= encodeURIComponent(token) %>" method="POST">
          <div class="form-group">
            <label for="password">New Password</label>
            <input id="password" type="password" name="password" minlength="8" autocomplete="new-password" required autofocus>
          </div>
          <div class="form-group">
            <label for="confirm_password">Confirm New Password</label>
            <input id="confirm_password" type="password" name="confirm_password" minlength="8" autocomplete="new-password" required>
          </div>
          <button type="submit" class="btn btn-primary btn-block">Reset Password</button>
        </form>

        <a href="/login" class="link-back mt-16" style="justify-content:center"><i data-lucide="arrow-left"></i> Back to Login</a>
      </div>
    </div>
  </div>
  <%- include('../partials/scripts') %>
</body>
</html>
