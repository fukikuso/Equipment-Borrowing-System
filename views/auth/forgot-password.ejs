<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <div class="login-shell">
    <div class="login-panel">
      <div class="login-card">
        <div class="ic-badge"><i data-lucide="key-round"></i></div>
        <h2>Reset Your Password</h2>
        <p class="subtitle">Enter your ID number and we'll help you regain access.</p>

        <%- include('../partials/flash') %>

        <form action="/forgot-password" method="POST">
          <div class="form-group">
            <label>Student/Instructor/Staff/Admin ID</label>
            <div class="input-icon-wrap">
              <i data-lucide="user" class="leading"></i>
              <input type="text" name="id_number" placeholder="Enter your ID number" required autofocus>
            </div>
          </div>
          <button type="submit" class="btn btn-primary btn-block">Send Reset Instructions</button>
        </form>

        <a href="/login" class="link-back mt-16" style="justify-content:center"><i data-lucide="arrow-left"></i> Back to Login</a>
      </div>
    </div>
  </div>
  <%- include('../partials/scripts') %>
</body>
</html>
