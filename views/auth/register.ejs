<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <div class="login-shell">
    <div class="login-panel">
      <div class="login-card register-card">
        <div class="ic-badge"><i data-lucide="user-round-plus"></i></div>
        <h2>Create an Account</h2>
        <p class="subtitle">Register to borrow CSPC equipment. You can sign in as soon as your account is created.</p>

        <%- include('../partials/flash') %>

        <form action="/register" method="POST" class="register-form">
          <div class="register-fields">
            <div class="form-group">
              <label for="role">Account Type</label>
              <select id="role" name="role" required>
                <option value="student" <%= formData.role === 'student' ? 'selected' : '' %>>Student</option>
                <option value="instructor" <%= formData.role === 'instructor' ? 'selected' : '' %>>Instructor</option>
                <option value="staff" <%= formData.role === 'staff' ? 'selected' : '' %>>Staff</option>
              </select>
            </div>
            <div class="form-group">
              <label for="full_name">Full Name</label>
              <input id="full_name" type="text" name="full_name" maxlength="150" value="<%= formData.full_name || '' %>" autocomplete="name" required autofocus>
            </div>
            <div class="form-group">
              <label for="id_number">School ID</label>
              <input id="id_number" type="text" name="id_number" maxlength="30" value="<%= formData.id_number || '' %>" autocomplete="username" required>
            </div>
            <div class="form-group">
              <label for="email">Email Address</label>
              <input id="email" type="email" name="email" maxlength="150" value="<%= formData.email || '' %>" autocomplete="email" required>
            </div>
            <div class="form-group">
              <label for="department">Department</label>
              <input id="department" type="text" name="department" maxlength="150" value="<%= formData.department || '' %>" required>
            </div>
            <div class="form-group">
              <label for="program">Program <span class="text-muted text-xs">(optional)</span></label>
              <input id="program" type="text" name="program" maxlength="150" value="<%= formData.program || '' %>">
            </div>
            <div class="form-group">
              <label for="password">Password</label>
              <input id="password" type="password" name="password" minlength="8" autocomplete="new-password" required>
            </div>
            <div class="form-group">
              <label for="confirm_password">Confirm Password</label>
              <input id="confirm_password" type="password" name="confirm_password" minlength="8" autocomplete="new-password" required>
            </div>
          </div>
          <button type="submit" class="btn btn-primary btn-block">Create Account <i data-lucide="arrow-right"></i></button>
        </form>

        <a href="/login" class="link-back mt-16" style="justify-content:center"><i data-lucide="arrow-left"></i> Back to Login</a>
      </div>
    </div>
  </div>
  <%- include('../partials/scripts') %>
</body>
</html>
