# Copy this file to .env and adjust if needed.
# Defaults below match a stock XAMPP MySQL install (root user, no password, port 3306).

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cspc_ebs

SESSION_SECRET=cspc-ebs-super-secret-change-me
PORT=3000

# Password reset email (SMTP). Use an app password for Gmail.
APP_BASE_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
    