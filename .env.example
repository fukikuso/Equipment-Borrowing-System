# Copy this file to .env for local development. Never commit .env.
# Production must use a managed database application user and a new random session secret.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cspc_ebs

SESSION_SECRET=replace-with-a-long-random-secret
PORT=3000
NODE_ENV=development

# Password reset email (SMTP). Use an app password for Gmail.
APP_BASE_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional MySQL CA certificate for managed databases, when required by the provider.
DB_SSL_CA=
    